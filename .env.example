# Payments (Paddle) environment variables

# Client-side token — REQUIRED. Read from the env var, never hard-coded.
# Sandbox/test token is prefixed `test_`, live token `live_`.
# The app derives the environment from this prefix and throws if the var is unset.
# .env.development -> test token (preview) | .env.production -> live token (published)
VITE_PAYMENTS_CLIENT_TOKEN=test_...

# Server-side keys (never exposed to the browser)
PADDLE_SANDBOX_API_KEY=test_...
PADDLE_LIVE_API_KEY=live_...

# Webhook signing secrets
PAYMENTS_SANDBOX_WEBHOOK_SECRET=pdl_ntfset_...
PAYMENTS_LIVE_WEBHOOK_SECRET=pdl_ntfset_...

# Required for the payments gateway
LOVABLE_API_KEY=...

# Backend (Lovable Cloud) — set automatically
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
