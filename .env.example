# Paddle Environment Variables

# LIVE API Key (Server-side)
# Get from: Paddle Dashboard > Developer > API Keys
PADDLE_LIVE_API_KEY=live_...

# SANDBOX API Key (Server-side)
# Get from: Paddle Dashboard > Developer > API Keys (Sandbox)
PADDLE_SANDBOX_API_KEY=test_...

# Client-side Token
# Get from: Paddle Dashboard > Developer > Authentication
# Prefixed with 'live_' for production, 'test_' for sandbox
VITE_PAYMENTS_CLIENT_TOKEN=live_...

# Webhook Secrets
# Get from: Paddle Dashboard > Developer > Webhooks
PAYMENTS_LIVE_WEBHOOK_SECRET=pdl_ntfset_...
PAYMENTS_SANDBOX_WEBHOOK_SECRET=pdl_ntfset_...

# Lovable API Key (Required for gateway)
LOVABLE_API_KEY=...
